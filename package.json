{
  "name": "beyaz-tahta",
  "productName": "Beyaz Tahta",
  "version": "1.0.0",
  "description": "Geliştiriciler, tasarımcılar ve üreticiler için yerel öncelikli etkileşimli fikir, proje ve not panosu.",
  "main": "electron/main.cjs",
  "author": "Teoman",
  "license": "SEE LICENSE IN LICENSE",
  "keywords": [
    "beyaz-tahta",
    "whiteboard",
    "backlog",
    "kanban",
    "productivity",
    "idea-tracker",
    "electron",
    "react",
    "vite",
    "local-first"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "electron:dev": "concurrently -k \"cross-env ELECTRON_DEV=true vite --port 5173\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV=true electron .\"",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.beyaztahta.app",
    "productName": "Beyaz Tahta",
    "electronDist": "node_modules/electron/dist",
    "asar": false,
    "directories": {
      "output": "release-yeni"
    },
    "icon": "assets/icon.ico",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "assets/**/*",
      "data/backlog.example.json",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "zip",
        "dir"
      ]
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  }
}
